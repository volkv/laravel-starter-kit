APP_NAME=laravel-app
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost:8080

# Host port for the local web server. Intentionally EMPTY in this template: several projects
# share one dev machine, and a copied default is how they end up fighting over the same port.
# Pick one nobody else uses, and keep APP_URL above in sync with it.
# Only the web port is published — postgres and redis are reachable over the compose network
# (`docker compose exec sql psql …` / `exec redis redis-cli`), so they need no host port at all.
APP_PORT=

COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

PHP_OPCACHE=0

DB_CONNECTION=pgsql
DB_HOST=sql
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=root
DB_PASSWORD=root

REDIS_HOST=redis
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GITHUB_CREDENTIALS=
GITHUB_REPOSITORY=
SERVER_IP=